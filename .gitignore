## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldReadme.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.scc
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
*.builds
*.pidb
*.svclog
*.scc

# Chutzpah Test files
_Chutzpah*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Files
*.e2e

# TFS 2012 Local Workspace
$tf/

# Guidance Automation Toolkit
*.gpState

# LightSwitch generated files
GeneratedArtifacts/
_TP_Model/
*.edmx.sql
*.vsmdi

# ReSharper
.vs.ReSharper/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity is a build add-in
_TeamCity*

# DotCover is a Code Coverage Tool
*.dotCover

# AxoSoft (AXMapping)
*.axaml
*.axdll

# Visual Studio 6 (and earlier)
*.clw
*.dsp
*.dsw

# Visual Studio 6 analyzer options
*.mdpolicy

# Rider
.idea/

# VSCode
.vscode/

# Node
node_modules/

# Git Extensions
*.Git*
!/.github/
!/.github/workflows/
!/.github/workflows/publish.yml
*.gitkeep

# Sonar
.sonarqube/

# SpecFlow
*.feature.cs

# Fakes
*.fakes

# ABuild
*.abuild

# *.user files can be committed (for example .csproj.user files)
# Uncomment the following line in case you want to ignore *.user files
#*.user

# Generated files by RadEditor/Xperience CMS (Kentico)
#RadEditor
#HTMLEditor

# SmartStore
#.smartstore
#.nuget

# Windows installer files from build outputs
*.msi
*.msix
*.msm
*.msp
*.mst

# JetBrains
*.DotSettings

# Cake
Cake_script.cmd

# Paket
.paket/
paket-files/

# Python
__pycache__/
*.py[cod]

# CMake
CMakeFiles/
cmake_install.cmake
CMakeCache.txt
CTestTestfile.cmake
compile_commands.json

# Browser application files
.sass-cache/
*.less.map
*.scss.map

# NuGet Packages
*.nupkg
*.snupkg
# NuGet Symbol Packages
*.symbols.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/SDL2/
#!**/[Pp]ackages/SDL2Native/

# MSBuild
*.exe
*.exe.config
*.dll
*.dll.config
*.pdb
*.mdb
*.ref

# Windows, IDE & project specific
Desktop.ini
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
.Trashes/
._*

# Windows shortcuts
*.lnk

# Local database and JWT credentials
/LinCtrlHost/local/

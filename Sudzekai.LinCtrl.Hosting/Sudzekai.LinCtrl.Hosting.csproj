<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sudzekai.LinCtrl.Abi.Mapping\Sudzekai.LinCtrl.Abi.Mapping.csproj" />
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sudzekai.LinCtrl.Abi.Allocation\Sudzekai.LinCtrl.Abi.Allocation.csproj" />
    <ProjectReference Include="..\Sudzekai.LinCtrl.Abi.Managed\Sudzekai.LinCtrl.Abi.Managed.csproj" />
    <ProjectReference Include="..\Sudzekai.LinCtrl.Abi\Sudzekai.LinCtrl.Abi.csproj" />
    <ProjectReference Include="..\Sudzekai.LinCtrl.Core\Sudzekai.LinCtrl.Core.csproj" />
    <ProjectReference Include="..\Sudzekai.LinCtrl.Extensions\Sudzekai.LinCtrl.Extensions.csproj" />
    <ProjectReference Include="..\Sudzekai.LinCtrl.Hosting.Application\Sudzekai.LinCtrl.Hosting.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TEST.Sudzekai.LinCtrl.Core" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sudzekai.LinCtrl.Hosting</PackageId>
    <Version>0.5.0</Version>
    <Title>Sudzekai LinCtrl Hosting</Title>
    <Description>Интеграция с ASP.NET Core для загрузки плагинов Native AOT, регистрации HTTP-маршрутов и управления запуском и выгрузкой плагинов.</Description>
    <Authors>Sudzekai</Authors>
    <Company>Sudzekai</Company>
    <Product>Sudzekai LinCtrl</Product>
    <Copyright>Copyright (c) Sudzekai</Copyright>
    <PackageTags>sudzekai;linctrl;plugins;nativeaot;aspnetcore;hosting;http</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/sudzekai-web-os/bundle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sudzekai-web-os/bundle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>

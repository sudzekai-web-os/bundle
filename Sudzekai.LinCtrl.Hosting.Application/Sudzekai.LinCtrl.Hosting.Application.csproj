<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sudzekai.LinCtrl.Core\Sudzekai.LinCtrl.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sudzekai.LinCtrl.Hosting.Application</PackageId>
    <Version>0.1.0</Version>
    <Title>Sudzekai LinCtrl Hosting Application</Title>
    <Description>Команды авторизации, репозитории MySQL и хэширование паролей Argon2id для хоста LinCtrl.</Description>
    <Authors>Sudzekai</Authors>
    <Company>Sudzekai</Company>
    <Product>Sudzekai LinCtrl</Product>
    <Copyright>Copyright (c) Sudzekai</Copyright>
    <PackageTags>sudzekai;linctrl;plugins;nativeaot;core;http;json</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/sudzekai-web-os/bundle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sudzekai-web-os/bundle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
